# Flask 세션 암호화 키 (운영 배포 시 반드시 무작위 값으로 교체)
SECRET_KEY=change-me-in-production

# 비워두면 로컬 SQLite(team_schedule.db) 사용. Supabase 등 Postgres 연결 시에만 설정.
DATABASE_URL=

# 최초 실행 시 사용자 테이블이 비어 있으면 자동으로 만들어지는 부트스트랩 관리자 계정
INITIAL_ADMIN_CODE=ADMIN001
INITIAL_ADMIN_NAME=시스템관리자

# 대시보드 자동 새로고침 주기 (밀리초)
REFRESH_INTERVAL=10000

# 로그인 시도 제한 (Rate Limit): WINDOW_SECONDS 동안 MAX회 초과 시 차단
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# 세션 만료(분), HTTPS 환경에서만 true로 설정
SESSION_LIFETIME_MINUTES=480
SESSION_COOKIE_SECURE=false

# 온라인 회의 - 채팅 내용 자동 정리에 사용 (Groq API, 무료 요금제 / 신용카드 등록 불필요)
# 발급: https://console.groq.com -> API Keys -> Create API Key
# 없으면 "정리하기" 버튼이 안내 메시지만 표시함
GROQ_API_KEY=
SUMMARY_MODEL=openai/gpt-oss-20b
